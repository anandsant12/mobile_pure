# ============================================================
# LLM provider toggle - the ONE switch that decides both the
# text (planning/resolving/verifying) model AND the vision model.
#   groq  -> uses GROQ_MODEL for text, GROQ_VISION_MODEL for vision
#   azure -> uses AZURE_OPENAI_DEPLOYMENT for BOTH text and vision
#            (point this at your gpt-4.1-mini deployment)
# ============================================================
LLM_PROVIDER=groq
ANDROID_UDID
# ---- Groq (only needed when LLM_PROVIDER=groq) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ---- Azure OpenAI (only needed when LLM_PROVIDER=azure) ----
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Your gpt-4.1-mini deployment name (used for both text and vision calls)
AZURE_OPENAI_DEPLOYMENT=

# ============================================================
# Appium / Android target
# ============================================================
APPIUM_SERVER_URL=http://127.0.0.1:4723
ANDROID_DEVICE_NAME=Android Device
ANDROID_APP_PACKAGE=com.sbi.lotusintouch
ANDROID_APP_ACTIVITY=com.sbi.lotusintouch.MainActivity
ANDROID_UDID=
ANDROID_PLATFORM_VERSION=
ANDROID_NO_RESET=true
ANDROID_NEW_COMMAND_TIMEOUT=900
ANDROID_AUTO_GRANT_PERMISSIONS=true

# ============================================================
# Agent behaviour
# ============================================================
MAX_STEPS=25
FUZZY_MATCH_THRESHOLD=75
ENABLE_VISION_FALLBACK=true
POPUP_DISMISS_ENABLED=true
